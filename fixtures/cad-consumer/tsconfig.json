{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "useDefineForClassFields": true,
    "paths": {
      "@/*": ["./src/*"],
      "@slopcad/cad-kernel": ["../../packages/cad-kernel/src/index.ts"],
      "@slopcad/cad-kernel/*": ["../../packages/cad-kernel/src/*.ts"]
    },
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts", "e2e"]
}
