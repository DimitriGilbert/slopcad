# The web app's environment template (README's setup step 2): copy to .env
# for local development. The auth secret is a DEV-ONLY placeholder — replace
# it with a fresh `openssl rand -base64 32` for any shared deployment.
BETTER_AUTH_SECRET=dev-only-placeholder-replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3001
# Extra origins (comma-separated) that may call the auth API besides
# BETTER_AUTH_URL — e.g. reaching the dev server over LAN.
# BETTER_AUTH_TRUSTED_ORIGINS=http://192.168.1.41:3001
DATABASE_URL=file:../../.data/local.db
