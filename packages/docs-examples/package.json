{
  "name": "@slopcad/docs-examples",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The runnable documentation examples (Phase 34): every guide in docs/guides references an example that lives here, and every example is machine-verified \u2014 `pnpm verify` typechecks and builds this package through the normal turbo graph, and its vitest suite RUNS each example and asserts the documented outcomes. The web app's /docs documentation application imports the browser-safe examples directly, so the page proves the same code the gates prove.",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": [
        "./src/*.ts",
        "./src/*.tsx"
      ]
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint ."
  },
  "dependencies": {
    "@slopcad/cad-components": "workspace:*",
    "@slopcad/cad-core": "workspace:*",
    "@slopcad/cad-io": "workspace:*",
    "@slopcad/cad-jsx": "workspace:*",
    "@slopcad/cad-jscad": "workspace:*",
    "@slopcad/cad-kernel": "workspace:*",
    "@slopcad/cad-kernel-manifold": "workspace:*",
    "@slopcad/cad-kernel-occt": "workspace:*",
    "@slopcad/cad-react": "workspace:*",
    "@slopcad/cad-sketch": "workspace:*"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "devDependencies": {
    "@slopcad/config": "workspace:*",
    "@types/react": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "react-dom": "catalog:"
  }
}
