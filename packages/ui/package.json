{
  "name": "@slopcad/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./lib/*": {
      "default": [
        "./src/lib/*.ts",
        "./src/lib/*.tsx"
      ]
    },
    "./components/*": {
      "default": [
        "./src/components/*.tsx",
        "./src/components/*.ts"
      ]
    },
    "./postcss.config": "./postcss.config.mjs"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint ."
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@slopcad/cad-r3f": "workspace:*",
    "@slopcad/cad-react": "workspace:*",
    "@shadcn/react": "^0.2.1",
    "@tanstack/react-form": "^1.33.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "lucide-react": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "^4.16.0",
    "sonner": "catalog:",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@slopcad/config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
