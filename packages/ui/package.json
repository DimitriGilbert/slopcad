{
  "name": "@slopcad/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./lib/*": {
      "default": [
        "./src/lib/*.ts",
        "./src/lib/*.tsx"
      ]
    },
    "./agent/*": {
      "default": [
        "./src/agent/*.ts",
        "./src/agent/*.tsx",
        "./src/agent/*/index.ts",
        "./src/agent/*/index.tsx"
      ]
    },
    "./agent/providers": "./src/agent/providers/index.ts",
    "./agent/chat/agent-chat-panel": "./src/agent/chat/agent-chat-panel.tsx",
    "./components/*": {
      "default": [
        "./src/components/*.tsx",
        "./src/components/*.ts"
      ]
    },
    "./postcss.config": "./postcss.config.mjs"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint ."
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@shadcn/react": "^0.2.1",
    "@slopcad/cad-core": "workspace:*",
    "@slopcad/cad-kernel": "workspace:*",
    "@slopcad/cad-kernel-manifold": "workspace:*",
    "@slopcad/cad-r3f": "workspace:*",
    "@slopcad/cad-react": "workspace:*",
    "@tanstack/ai": "^0.64.0",
    "@tanstack/ai-anthropic": "^0.19.4",
    "@tanstack/ai-client": "^0.36.1",
    "@tanstack/ai-gemini": "^0.34.2",
    "@tanstack/ai-openai": "^0.26.0",
    "@tanstack/ai-openrouter": "^0.20.2",
    "@tanstack/ai-react": "^0.29.4",
    "@tanstack/react-form": "^1.33.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "lucide-react": "catalog:",
    "manifold-3d": "3.5.3",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.16.0",
    "sonner": "catalog:",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@slopcad/config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
