{
  "name": "slopcad",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:fast": "pnpm --filter web test:fast",
    "test:render": "pnpm --filter web test:render",
    "test:render:gate": "node scripts/render-gate.mjs",
    "test:floor-probe": "pnpm --filter web probe:floor",
    "test:spike": "pnpm --filter web test:spike",
    "test:perf": "pnpm --filter web test:perf",
    "smoke:consumer": "pnpm -C fixtures/cad-consumer smoke",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "pnpm test:coverage && pnpm quality:crap && pnpm quality:duplication && pnpm quality:report",
    "quality:crap": "crap --json=reports/crap/web.json --html=reports/crap/web-html apps/web/coverage/coverage-final.json && crap --json=reports/crap/ui.json --html=reports/crap/ui-html packages/ui/coverage/coverage-final.json && crap --json=reports/crap/api.json --html=reports/crap/api-html packages/api/coverage/coverage-final.json && crap --json=reports/crap/auth.json --html=reports/crap/auth-html packages/auth/coverage/coverage-final.json && crap --json=reports/crap/db.json --html=reports/crap/db-html packages/db/coverage/coverage-final.json && crap --json=reports/crap/env.json --html=reports/crap/env-html packages/env/coverage/coverage-final.json",
    "quality:duplication": "jscpd --config jscpd.config.json --noTips .",
    "quality:report": "node scripts/quality-report.mjs",
    "quality:knip": "knip",
    "registry:build": "bash scripts/registry-build.sh",
    "registry:validate": "node scripts/registry-validate.mjs --artifacts",
    "registry:regenerate": "bash scripts/cad-registry-regenerate.sh",
    "registry:matrix": "bash scripts/cad-registry-matrix.sh",
    "clean:verify": "bash scripts/clean-checkout-verify.sh",
    "verify": "pnpm run check-types && pnpm run lint && pnpm run format:check && pnpm test && pnpm build",
    "dev:web": "turbo run dev -F web --",
    "db:push": "turbo run db:push -F @slopcad/db --",
    "db:studio": "turbo run db:studio -F @slopcad/db --",
    "db:generate": "turbo run db:generate -F @slopcad/db --",
    "db:migrate": "turbo run db:migrate -F @slopcad/db --",
    "db:local": "turbo run db:local -F @slopcad/db --",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "test:docs": "pnpm --filter web test:docs",
    "test:matrix": "pnpm --filter web test:matrix",
    "webkit:deps": "bash scripts/webkit-user-deps.sh"
  },
  "dependencies": {
    "@slopcad/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@slopcad/config": "workspace:*",
    "@types/node": "catalog:",
    "crap-score": "^1.2.1",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jscpd": "^4.2.4",
    "knip": "^5.64.0",
    "prettier": "^3.6.2",
    "turbo": "^2.10.7",
    "typescript": "catalog:",
    "typescript-eslint": "^8.46.0"
  },
  "packageManager": "pnpm@10.34.5"
}
